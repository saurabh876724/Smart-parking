# Smart Parking System - Environment Configuration
# Copy to .env and fill in values before running docker compose up

# ─── JWT Authentication ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SMART_PARKING_JWT_SECRET=change-me-to-a-long-random-string

# ─── Database ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-to-a-strong-password
# The app runs on SQLite (data/smart_parking.db) unless told otherwise.
# SMART_PARKING_DATABASE_URL is the one name both the running API and
# scripts/migrate.py read; to move to the compose postgres service, start it
# with `--profile postgres` and uncomment the postgresql line below.
# SMART_PARKING_DATABASE_URL=postgresql://parking_admin:${POSTGRES_PASSWORD}@db/smart_parking

# ─── API Configuration ───────────────────────────────────────────────
# Not environment variables: the host, port and log level are command-line
# arguments to `scripts/serve.py`, which docker-compose.yml already sets to
# `--host 0.0.0.0`. The startup pipeline/persistence switches are arguments too.
# They are listed here only as a reminder of where those knobs live:
#   API_HOST / API_PORT / LOG_LEVEL  -> serve.py --host --port --log-level
#   ENABLE_PIPELINES / --persist     -> serve.py --no-pipelines / --persist

# ─── Liveness probe ──────────────────────────────────────────────────
# `/health` is authenticated by design, so the api container's healthcheck logs in
# first instead: a 200 from /auth/login proves the API, the database and the auth
# layer are all up at once. docker-compose.yml interpolates both of these with the
# `:?` suffix, so `docker compose config` refuses to start the stack without them.
# Give the probe a real VIEWER account of its own - not an admin, and not yours.
HEALTH_EMAIL=change-me-to-a-probe-account@example.com
HEALTH_PASSWORD=change-me-to-the-probe-account-password

# ─── CORS ────────────────────────────────────────────────────────────
# Not an environment variable: the allow-list lives in configs/app.yaml under
# api.cors.allow_origins (empty by default - the deployed dashboard is
# same-origin through nginx). Add an origin there only if a browser calls
# the API on :8000 directly.
